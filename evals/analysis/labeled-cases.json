[
  {
    "id": "literal",
    "code": "var x=load(\"res://a.tres\")",
    "expected": [
      [
        "load",
        "a.tres"
      ]
    ],
    "extra_files": {}
  },
  {
    "id": "comment",
    "code": "# load(\"res://ghost.tres\")\nconst X=preload(\"res://a.tres\")",
    "expected": [
      [
        "preload",
        "a.tres"
      ]
    ],
    "extra_files": {}
  },
  {
    "id": "triple-string",
    "code": "var doc=\"\"\"\nload(\"res://ghost.tres\")\n\"\"\"",
    "expected": [],
    "extra_files": {}
  },
  {
    "id": "constant-concatenation",
    "code": "const BASE=\"res://\"\nconst NAME=\"a\"\nfunc go():\n var x=load(BASE+NAME+\".tres\")",
    "expected": [
      [
        "load",
        "a.tres"
      ]
    ],
    "extra_files": {}
  },
  {
    "id": "constant-substitution",
    "code": "const NAME=\"a\"\nvar x=load(\"res://%s.tres\" % NAME)",
    "expected": [
      [
        "load",
        "a.tres"
      ]
    ],
    "extra_files": {}
  },
  {
    "id": "parameter-shadow",
    "code": "const PATH=\"res://a.tres\"\nfunc go(PATH: String):\n var x=load(PATH)",
    "expected": [],
    "extra_files": {}
  },
  {
    "id": "local-shadow",
    "code": "const PATH=\"res://a.tres\"\nfunc go():\n var PATH=\"res://b.tres\"\n var x=load(PATH)",
    "expected": [],
    "extra_files": {}
  },
  {
    "id": "resource-uid",
    "code": "const X=preload(\"uid://asset\")",
    "expected": [
      [
        "preload",
        "a.tres"
      ]
    ],
    "extra_files": {
      "a.tres": "[gd_resource format=3 uid=\"uid://asset\"]"
    }
  },
  {
    "id": "script-uid",
    "code": "var x=load(\"uid://script\")",
    "expected": [
      [
        "load",
        "base.gd"
      ]
    ],
    "extra_files": {
      "base.gd.uid": "uid://script"
    }
  },
  {
